#!/bin/sh
# Stop any prior install so the reinstall/update is clean (unload alone leaves the plist to relaunch a
# now-replaced binary). Best-effort throughout.
launchctl unload /Library/LaunchDaemons/com.tailscale.tailscaled.plist 2>/dev/null || true
CONSOLE_UID=$(stat -f %u /dev/console 2>/dev/null || echo 0)
if [ "${CONSOLE_UID:-0}" -gt 0 ]; then
  for a in com.tailscale.systray com.tailscale.updatecheck; do
    launchctl asuser "$CONSOLE_UID" launchctl unload "/Library/LaunchAgents/$a.plist" 2>/dev/null || true
  done
fi
exit 0
