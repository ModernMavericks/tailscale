$NetBSD$

Mac OS X 10.9 (Mavericks): reimplement Security.framework APIs newer than the
10.9 SDK (SecKeyCreateSignature/SecKeyAlgorithm 10.12, SecTrustEvaluateWithError
10.14, SecTrustCopyCertificateChain 10.15) with APIs that exist on 10.9, each
block wrapped in `#if __MAC_OS_X_VERSION_MAX_ALLOWED < NNN` so a newer SDK
compiles it out and links the real symbols -- off-target it is a no-op.

--- ../github.com/tailscale/certstore@v0.1.1-0.20260409135935-3638fb84b77d/certstore_darwin.go.orig	2026-07-14 06:33:17.000000000 -0400
+++ ../github.com/tailscale/certstore@v0.1.1-0.20260409135935-3638fb84b77d/certstore_darwin.go
@@ -1,10 +1,131 @@
 package certstore
 
 /*
-#cgo CFLAGS: -x objective-c
+#cgo CFLAGS: -x objective-c -Wno-deprecated-declarations
 #cgo LDFLAGS: -framework CoreFoundation -framework Security
 #include <CoreFoundation/CoreFoundation.h>
 #include <Security/Security.h>
+
+#if !defined(__MAC_OS_X_VERSION_MAX_ALLOWED) || __MAC_OS_X_VERSION_MAX_ALLOWED < 101500
+static CFArrayRef SecTrustCopyCertificateChain(SecTrustRef trust) {
+	// build chain array from per-index accessors
+	CFIndex n = SecTrustGetCertificateCount(trust);
+	CFMutableArrayRef arr = CFArrayCreateMutable(kCFAllocatorDefault, n, &kCFTypeArrayCallBacks);
+	CFIndex i;
+	if (arr == NULL) {
+		return NULL;
+	}
+	for (i = 0; i < n; i++) {
+		SecCertificateRef c = SecTrustGetCertificateAtIndex(trust, i);
+		if (c != NULL) {
+			CFArrayAppendValue(arr, c);
+		}
+	}
+	return arr;
+}
+#endif
+
+#if !defined(__MAC_OS_X_VERSION_MAX_ALLOWED) || __MAC_OS_X_VERSION_MAX_ALLOWED < 101400
+static Boolean SecTrustEvaluateWithError(SecTrustRef trust, CFErrorRef *error) {
+	// caller only needs chain-population side effect
+	SecTrustResultType result = kSecTrustResultInvalid;
+	OSStatus s = SecTrustEvaluate(trust, &result);
+	if (error != NULL) {
+		*error = NULL;
+	}
+	return (s == errSecSuccess) &&
+	       (result == kSecTrustResultProceed || result == kSecTrustResultUnspecified);
+}
+#endif
+
+#if !defined(__MAC_OS_X_VERSION_MAX_ALLOWED) || __MAC_OS_X_VERSION_MAX_ALLOWED < 101200
+// On 10.9 the signing primitive is the Security Transforms API.  Its headers
+// (<Security/SecTransform.h> ...) use Apple's Blocks "^" extension, which gcc
+// cannot parse, so declare just the few symbols we need directly; they resolve
+// at link time from -framework Security.
+typedef CFTypeRef SecTransformRef;
+extern SecTransformRef SecSignTransformCreate(SecKeyRef key, CFErrorRef *error);
+extern Boolean SecTransformSetAttribute(SecTransformRef ref, CFStringRef key, CFTypeRef value, CFErrorRef *error);
+extern CFTypeRef SecTransformExecute(SecTransformRef ref, CFErrorRef *error);
+extern CFStringRef kSecInputIsAttributeName;
+extern CFStringRef kSecInputIsDigest;
+extern const CFStringRef kSecDigestTypeAttribute;
+extern const CFStringRef kSecDigestSHA2;
+extern const CFStringRef kSecDigestLengthAttribute;
+extern const CFStringRef kSecTransformInputAttributeName;
+
+// SecKeyAlgorithm is represented as a small tag; RSA-PSS is not expressible via
+// Security Transforms and returns NULL here (handled by an OpenSSL path
+// elsewhere).
+typedef enum {
+	kSecKeyAlgorithmECDSASignatureDigestX962SHA256 = 1,
+	kSecKeyAlgorithmECDSASignatureDigestX962SHA384,
+	kSecKeyAlgorithmECDSASignatureDigestX962SHA512,
+	kSecKeyAlgorithmRSASignatureDigestPKCS1v15SHA256,
+	kSecKeyAlgorithmRSASignatureDigestPKCS1v15SHA384,
+	kSecKeyAlgorithmRSASignatureDigestPKCS1v15SHA512,
+	kSecKeyAlgorithmRSASignatureDigestPSSSHA256,
+	kSecKeyAlgorithmRSASignatureDigestPSSSHA384,
+	kSecKeyAlgorithmRSASignatureDigestPSSSHA512
+} SecKeyAlgorithm;
+
+static CFDataRef SecKeyCreateSignature(SecKeyRef key, SecKeyAlgorithm algorithm, CFDataRef dataToSign, CFErrorRef *error) {
+	int digestLength;
+	SecTransformRef tr;
+	CFDataRef sig;
+	CFNumberRef len;
+	Boolean ok;
+
+	switch (algorithm) {
+	case kSecKeyAlgorithmECDSASignatureDigestX962SHA256:
+	case kSecKeyAlgorithmRSASignatureDigestPKCS1v15SHA256:
+		digestLength = 256;
+		break;
+	case kSecKeyAlgorithmECDSASignatureDigestX962SHA384:
+	case kSecKeyAlgorithmRSASignatureDigestPKCS1v15SHA384:
+		digestLength = 384;
+		break;
+	case kSecKeyAlgorithmECDSASignatureDigestX962SHA512:
+	case kSecKeyAlgorithmRSASignatureDigestPKCS1v15SHA512:
+		digestLength = 512;
+		break;
+	default:
+		// RSA-PSS (or anything unexpected): not available via Security
+		// Transforms on this OS.
+		if (error != NULL) {
+			*error = NULL;
+		}
+		return NULL;
+	}
+
+	tr = SecSignTransformCreate(key, error);
+	if (tr == NULL) {
+		return NULL;
+	}
+
+	sig = NULL;
+	len = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &digestLength);
+	ok = SecTransformSetAttribute(tr, kSecInputIsAttributeName, kSecInputIsDigest, error) &&
+	     SecTransformSetAttribute(tr, kSecDigestTypeAttribute, kSecDigestSHA2, error) &&
+	     SecTransformSetAttribute(tr, kSecDigestLengthAttribute, len, error) &&
+	     SecTransformSetAttribute(tr, kSecTransformInputAttributeName, dataToSign, error);
+	if (len != NULL) {
+		CFRelease(len);
+	}
+	if (ok) {
+		CFTypeRef out = SecTransformExecute(tr, error);
+		if (out != NULL) {
+			if (CFGetTypeID(out) == CFDataGetTypeID()) {
+				sig = (CFDataRef)out; // ownership transferred to caller
+			} else {
+				CFRelease(out);
+			}
+		}
+	}
+	CFRelease(tr);
+	return sig;
+}
+#endif
 */
 import "C"
 import (
